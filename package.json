{
  "name": "cortico-world-sound-del",
  "version": "0.1.6",
  "type": "module",
  "description": "为 Coopanion 加上类似微信输入法、网易兔八哥的收音静音体验：按下原收音快捷键，后台播放自动静音，结束后恢复，不用手动暂停音乐或视频。无需修改主程序；适用于 Windows x64，依赖内置语音模块。",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "audio",
    "windows"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Sound Del",
    "describe": "describe.json",
    "locales": {
      "zh": {
        "displayName": "收音静音",
        "description": "为 Coopanion 加上类似微信输入法、网易兔八哥的收音静音体验：按下原收音快捷键，后台播放自动静音，结束后恢复，不用手动暂停音乐或视频。无需修改主程序；适用于 Windows x64，依赖内置语音模块。"
      },
      "en": {
        "displayName": "Sound Del",
        "description": "Brings mute-while-speaking, familiar from tools such as WeChat Input (微信输入法) and 网易兔八哥, to Coopanion. Keeps your recording shortcut and restores playback afterward. Windows x64; requires the built-in voice module."
      }
    },
    "icon": "assets/icon.svg",
    "tags": [
      "voice",
      "requires-extension",
      "experimental"
    ]
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "src",
    "native/src",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "scripts",
    "tests",
    "tsconfig.json",
    "tsconfig.build.json",
    "rust-toolchain.toml",
    "README.md",
    "README_zh.md",
    "USAGE.md",
    "CHANGELOG.md",
    "VALIDATION.md",
    "PUBLISHING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "node scripts/build-native.mjs",
    "build:ts": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:ts && npm run test:native && npm run test:integration",
    "test:ts": "tsx --test tests/*.test.ts",
    "test:native": "node scripts/rust.mjs test --locked --manifest-path native/Cargo.toml",
    "pretest:integration": "npm run build",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "check": "npm run typecheck && npm test && npm run check:extension && npm run verify:package",
    "probe": "node scripts/helper-cli.mjs --probe",
    "recover": "node scripts/helper-cli.mjs --recover-only",
    "check:extension": "node --import tsx scripts/check-extension.mjs",
    "verify:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/ws": "8.18.1",
    "cortico": "0.2.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "author": {
    "name": "sy0u1ti",
    "url": "https://github.com/sy0u1ti"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sy0u1ti/cortico-world-sound-del.git"
  },
  "homepage": "https://github.com/sy0u1ti/cortico-world-sound-del#readme",
  "bugs": {
    "url": "https://github.com/sy0u1ti/cortico-world-sound-del/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
